---
import type { ProjectEntry } from "../../lib/projects/selectors";
import { getPosts } from "../../lib/posts/selectors";
import Card from "./Card.astro";

interface Props {
  project: ProjectEntry;
}

const { project } = Astro.props;
const { data } = project;
const repo = "repo" in data ? data.repo : data.github;
const stats = data.repositoryStats;
const tags = [...new Set([data.category, ...data.tags, ...data.technologies])];
const linkedIds = new Set(data.linkedPosts.map((post) => post.id));
const posts = (await getPosts()).filter((post) => linkedIds.has(post.id));
const createdAt = data.createdAt ?? data.publishedAt;
const updatedAt = data.updatedAt ?? data.pushedAt;
const links = [
  { label: "github source", href: repo },
  { label: "live deployment", href: data.demo },
  { label: "docs", href: data.docs },
].filter((link) => link.href);
const formatDate = (date: Date) =>
  date.toLocaleDateString("en-US", {
    month: "2-digit",
    day: "2-digit",
    year: "numeric",
    timeZone: "UTC",
  });
const formatNumber = (value: number) => value.toLocaleString("en-US");
const formatPercentage = (value: number) =>
  value < 0.1 ? "<0.1" : String(Number(value.toFixed(1)));
---

<aside class="project-sidebar" aria-label={`${data.title} metadata`}>
  <section aria-labelledby="project-about">
    <h2 id="project-about">About</h2>
    <h1>{data.title}</h1>
    {data.description && <p>{data.description}</p>}
    <p class="project-status">
      {data.category} / {data.status}
    </p>
    {stats && repo && (
      <ul class="repo-stats" aria-label="GitHub repository statistics">
        <li>
          <a href={`${repo}/stargazers`}>
            {formatNumber(stats.stars)} stars <span aria-hidden="true">★</span>
          </a>
        </li>
        <li>
          <a href={`${repo}/forks`}>{formatNumber(stats.forks)} forks</a>
        </li>
        <li>
          <a href={`${repo}/watchers`}>
            {formatNumber(stats.watchers)} watching
          </a>
        </li>
        {stats.contributors !== undefined && (
          <li>
            <a href={`${repo}/graphs/contributors`}>
              {formatNumber(stats.contributors)} contributors
            </a>
          </li>
        )}
      </ul>
    )}
  </section>

  {tags.length > 0 && (
    <section aria-labelledby="project-tags">
      <h2 id="project-tags">Tags</h2>
      <p>{tags.join(", ")}</p>
    </section>
  )}

  <section aria-labelledby="project-posts">
    <h2 id="project-posts">Related Posts</h2>
    {posts.length > 0 ? (
      <ul class="related-posts">
        {posts.map((post) => (
          <li>
            <Card href={`/posts/${post.id}`}>
              <span class="related-post">
                <span class="related-post__title">- {post.data.title}</span>
                <time datetime={post.data.publishedAt.toISOString()}>
                  {formatDate(post.data.publishedAt)}
                </time>
                <span aria-hidden="true">›</span>
              </span>
            </Card>
          </li>
        ))}
      </ul>
    ) : (
      <p class="muted">No related posts yet.</p>
    )}
  </section>

  {links.length > 0 && (
    <section aria-labelledby="project-links">
      <h2 id="project-links">Links</h2>
      <ul class="project-links">
        {links.map((link) => (
          <li>
            <a href={link.href}>{link.label}</a>
          </li>
        ))}
      </ul>
    </section>
  )}

  {data.languages.length > 0 && (
    <section aria-labelledby="project-languages">
      <h2 id="project-languages">Languages</h2>
      <ul class="project-languages">
        {data.languages.map((language) => (
          <li>
            <span>{formatPercentage(language.percentage)}%</span>{" "}
            {language.name}
          </li>
        ))}
      </ul>
    </section>
  )}

  {(createdAt || updatedAt) && (
    <footer class="project-dates">
      {createdAt && (
        <span>
          created{" "}
          <time datetime={createdAt.toISOString()}>
            {formatDate(createdAt)}
          </time>
        </span>
      )}
      {updatedAt && (
        <span>
          updated{" "}
          <time datetime={updatedAt.toISOString()}>
            {formatDate(updatedAt)}
          </time>
        </span>
      )}
    </footer>
  )}
</aside>

<style>
  .project-sidebar {
    min-width: 0;
    border: var(--border-width) solid var(--color-border);
    padding: var(--space-4);
    display: grid;
    gap: var(--space-8);
    font-size: 0.8125rem;
    line-height: 1.6;
    overflow-wrap: anywhere;
  }

  @media (width > 56rem) {
    .project-sidebar {
      /* Clear the sticky topbar's 64px logo and top padding. */
      --sidebar-top: calc(64px + var(--space-6) + var(--space-4));
      position: sticky;
      top: var(--sidebar-top);
      align-self: start;
      max-height: calc(100dvh - var(--sidebar-top) - var(--space-4));
      overflow-y: auto;
      scrollbar-width: thin;
      scrollbar-color: var(--color-border) var(--color-bg);
    }
  }

  h2 {
    margin: 0 0 var(--space-1);
    font-size: 1.375rem;
    font-weight: normal;
    line-height: 1.3;
  }

  h1 {
    margin: 0 0 var(--space-2);
    font-size: 1rem;
    font-weight: normal;
  }

  p,
  ul {
    margin: 0;
  }
  ul {
    padding: 0;
    list-style: none;
  }
  .project-status {
    margin-top: var(--space-2);
  }
  .muted,
  .project-status,
  .project-dates {
    color: var(--color-text-muted);
  }
  .repo-stats {
    margin-top: var(--space-4);
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: var(--space-3);
  }
  .repo-stats a {
    text-decoration: none;
  }
  a:hover {
    text-decoration: underline;
  }
  a:focus-visible {
    outline: 2px solid var(--color-text);
    outline-offset: 3px;
  }
  .related-posts {
    display: grid;
    gap: var(--space-2);
  }
  .related-post {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }
  .related-post__title {
    flex: 1;
  }
  .related-post time {
    font-size: 0.6875rem;
    color: var(--color-text-muted);
    white-space: nowrap;
  }
  .project-links a {
    text-underline-offset: 3px;
  }
  .project-languages {
    border-top: 1px dashed var(--color-border);
    padding-top: var(--space-2);
  }
  .project-dates {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--space-2);
    font-size: 0.6875rem;
  }
</style>

---
import Card from "./Card.astro";

interface Props {
  title: string;
  href: string;
  date: Date;
  featured?: boolean;
}

const { title, href, date, featured = false } = Astro.props;

const formattedDate = date.toLocaleDateString("en-US", {
  month: "2-digit",
  day: "2-digit",
  year: "numeric",
  timeZone: "UTC",
});
---

<Card href={href}>
  <div class="post-card">
    <div class="post-card__title">
      <span aria-hidden="true">-</span>

      <span>{title}</span>

      {featured && (
        <span class="post-card__featured" aria-label="Featured post">
          ★
        </span>
      )}
    </div>

    <div class="post-card__meta">
      <time datetime={date.toISOString()}>{formattedDate}</time>

      <span aria-hidden="true">›</span>
    </div>
  </div>
</Card>

<style>
  .post-card {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);

    color: inherit;
    text-decoration: none;
  }

  .post-card__title {
    display: flex;
    align-items: center;
    gap: var(--space-2);

    min-width: 0;
  }

  .post-card__featured {
    color: var(--color-text);
  }

  .post-card__meta {
    display: flex;
    align-items: center;
    gap: var(--space-3);

    flex-shrink: 0;

    color: var(--color-text-muted);
  }

  @media (max-width: 36rem) {
    .post-card__meta time {
      display: none;
    }
  }
</style>

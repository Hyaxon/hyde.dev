---
interface Props {
  title?: string;
  class?: string;
}

const { title, class: className } = Astro.props;

const hasAction = Astro.slots.has("action");
---

<section class:list={["item-box", className]} aria-label={title}>
  {title && <h2 class="item-box__title">{title}</h2>}

  {hasAction && (
    <div class="item-box__action">
      <slot name="action" />
    </div>
  )}

  <div class="item-box__content">
    <slot />
  </div>
</section>

<style>
  .item-box {
    position: relative;

    border: var(--border-width) solid var(--color-border);
    background: var(--color-bg);
  }

  .item-box__title {
    position: absolute;
    top: 0;
    left: var(--space-6);

    margin: 0;
    padding-inline: var(--space-3);

    background: var(--color-bg);

    font: inherit;
    font-size: var(--font-size-xl);
    font-weight: normal;
    line-height: 1;

    transform: translateY(-50%);
  }

  .item-box__action {
    position: absolute;
    top: 0;
    right: var(--space-6);

    padding-inline: var(--space-2);

    background: var(--color-bg);

    transform: translateY(-50%);
  }

  .item-box__content {
    padding: var(--space-6);
  }

</style>

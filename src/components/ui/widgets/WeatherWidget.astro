---
import placeholder from "../../../assets/pixel/widgets/weather-placeholder.svg";
import info from "../../../assets/pixel/info.png";

interface Props {
  weather: {
    city: string;
    timezone: string;
    observedAt: string;
    condition: string;
    temperature: number;
    high: number;
    low: number;
    humidity: number | null;
    uvIndex: number | null;
    airQuality: string | null;
  };
  iconSrc?: string;
}

const { weather, iconSrc = placeholder.src } = Astro.props;
const observedAt = new Date(weather.observedAt);
const time = new Intl.DateTimeFormat("en-US", {
  timeZone: weather.timezone,
  hour: "numeric",
  minute: "2-digit",
  hour12: true,
})
  .format(observedAt)
  .replace(/\s/g, "");
const fullTime = new Intl.DateTimeFormat("en-US", {
  timeZone: weather.timezone,
  dateStyle: "medium",
  timeStyle: "short",
}).format(observedAt);
---

<div class="weather-widget" aria-label={`Weather in ${weather.city}`}>
  <weather-attribution class="weather-widget__attribution">
    <details>
      <summary aria-label="Weather data attribution">
        <span
          style={{ "--info-icon": `url("${info.src}")` }}
          aria-hidden="true"
        />
      </summary>
      <div class="weather-widget__attribution-card">
        <p class="weather-widget__attribution-title">Weather data</p>
        <p>
          Weather by <a href="https://open-meteo.com/">Open-Meteo</a>.
        </p>
        <p>
          Air quality by <a href="https://atmosphere.copernicus.eu/">CAMS</a>,
          via Open-Meteo.
        </p>
        <p>
          Data licensed under{" "}
          <a href="https://creativecommons.org/licenses/by/4.0/">CC BY 4.0</a>.
          Values rounded and conditions formatted for display.
        </p>

        <p>Weather data refreshes hourly.</p>
      </div>
    </details>
  </weather-attribution>
  <div class="weather-widget__layout">
    <div class="weather-widget__condition">
      <img src={iconSrc} width="32" height="32" alt="" />
      <p>{weather.condition}</p>
    </div>

    <div class="weather-widget__summary">
      <p class="weather-widget__city">{weather.city}</p>
      <time
        datetime={weather.observedAt}
        title={`Conditions as of ${fullTime}`}
      >
        <span class="sr-only">Conditions as of </span>
        {time}
      </time>
      <p
        class="weather-widget__temperature"
        aria-label={`${Math.round(weather.temperature)} degrees Fahrenheit`}
      >
        {Math.round(weather.temperature)}°F
      </p>
      <p class="weather-widget__range">
        <span>Hi: {Math.round(weather.high)}</span>
        <span>Lo: {Math.round(weather.low)}</span>
      </p>
    </div>

    <dl class="weather-widget__details">
      <div>
        <dt>Humidity:</dt>
        <dd>
          {weather.humidity === null ? "—" : `${Math.round(weather.humidity)}%`}
        </dd>
      </div>
      <div>
        <dt>UV Index:</dt>
        <dd>{weather.uvIndex === null ? "—" : weather.uvIndex}</dd>
      </div>
      <div>
        <dt>
          <abbr title="Air quality index">AQI</abbr>:
        </dt>
        <dd>{weather.airQuality ?? "—"}</dd>
      </div>
    </dl>
  </div>
</div>

<script>
  class WeatherAttribution extends HTMLElement {
    private cleanup?: AbortController;

    connectedCallback() {
      this.cleanup?.abort();
      this.cleanup = new AbortController();
      const { signal } = this.cleanup;
      const details = this.querySelector("details");
      if (!details) return;

      this.addEventListener(
        "pointerenter",
        (event) => {
          if (event.pointerType === "mouse") details.open = true;
        },
        { signal },
      );
      this.addEventListener(
        "pointerleave",
        () => {
          if (!this.contains(document.activeElement)) details.open = false;
        },
        { signal },
      );
      this.addEventListener(
        "focusin",
        (event) => {
          if (
            event.target instanceof Element &&
            event.target.matches(":focus-visible")
          ) {
            details.open = true;
          }
        },
        { signal },
      );
      this.addEventListener(
        "focusout",
        (event) => {
          if (
            !(event.relatedTarget instanceof Node) ||
            !this.contains(event.relatedTarget)
          ) {
            details.open = false;
          }
        },
        { signal },
      );
      this.addEventListener(
        "keydown",
        (event) => {
          if (event.key === "Escape") {
            details.querySelector("summary")?.focus();
            details.open = false;
          }
        },
        { signal },
      );
      document.addEventListener(
        "pointerdown",
        (event) => {
          if (event.target instanceof Node && !this.contains(event.target))
            details.open = false;
        },
        { signal },
      );
    }

    disconnectedCallback() {
      this.cleanup?.abort();
    }
  }

  if (!customElements.get("weather-attribution")) {
    customElements.define("weather-attribution", WeatherAttribution);
  }
</script>

<style>
  .weather-widget__attribution {
    position: absolute;
    top: -16px;
    right: -16px;
    z-index: 2;
  }

  .weather-widget__attribution summary {
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    list-style: none;
    cursor: pointer;
    color: var(--color-text-muted);
    transition: color var(--duration-fast) var(--ease-standard);
  }

  .weather-widget__attribution summary::-webkit-details-marker {
    display: none;
  }
  .weather-widget__attribution summary span {
    width: 16px;
    height: 16px;
    background: currentColor;
    mask: var(--info-icon) center / contain no-repeat;
    image-rendering: pixelated;
  }

  .weather-widget__attribution summary:hover,
  .weather-widget__attribution summary:focus-visible,
  .weather-widget__attribution details[open] summary {
    color: var(--color-text);
  }

  .weather-widget__attribution summary:focus-visible,
  .weather-widget__attribution-card a:focus-visible {
    outline: 2px solid var(--color-text);
    outline-offset: 2px;
  }

  .weather-widget__attribution-card {
    position: absolute;
    top: 100%;
    right: 0;
    width: min(18rem, calc(100vw - 3rem));
    padding: var(--space-4);
    border: var(--border-width) solid var(--color-border);
    background: var(--color-panel);
    box-shadow: 0 4px 12px #0006;
    font-size: 0.75rem;
    line-height: 1.6;
  }

  .weather-widget__attribution-card p + p {
    margin-top: var(--space-2);
  }
  .weather-widget__attribution-title {
    color: #fff;
  }
  .weather-widget__attribution-card a {
    color: var(--color-text-muted);
  }
  .weather-widget__attribution-card a {
    text-underline-offset: 0.2em;
  }
  .weather-widget__attribution-card a:hover,
  .weather-widget__attribution-card a:focus-visible {
    color: var(--color-text);
  }

  .weather-widget {
    position: relative;
    container-type: inline-size;
    font-size: 1rem;
    line-height: 1.4;
    font-variant-numeric: tabular-nums;
  }

  .weather-widget__layout {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: var(--space-6);
  }

  p,
  dl,
  dd {
    margin: 0;
  }

  .weather-widget__condition {
    display: grid;
    justify-items: center;
    gap: var(--space-2);
  }

  .weather-widget__condition img {
    width: 96px;
    height: 96px;
    image-rendering: pixelated;
  }

  .weather-widget__city {
    color: #fff;
  }

  .weather-widget__summary time {
    color: var(--color-text);
  }

  .weather-widget__temperature {
    margin-block: var(--space-2);
    font-size: 2.75rem;
    line-height: 1;
    white-space: nowrap;
  }

  .weather-widget__range {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    color: var(--color-text-muted);
  }

  .weather-widget__details {
    display: grid;
    gap: 0;
  }

  .weather-widget__details div {
    display: flex;
    justify-content: space-between;
    gap: var(--space-4);
  }

  .weather-widget__details dd {
    text-align: right;
  }
  abbr {
    text-decoration: none;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  @container (max-width: 27rem) {
    .weather-widget__layout {
      grid-template-columns: auto minmax(0, 1fr);
      gap: var(--space-4);
    }
    .weather-widget__condition img {
      width: 64px;
      height: 64px;
    }
    .weather-widget__details {
      grid-column: 1 / -1;
    }
  }
</style>

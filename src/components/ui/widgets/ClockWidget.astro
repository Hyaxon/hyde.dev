---
import icon from "../../../assets/pixel/widgets/clock.png";
import { locationConfig } from "../../../data/location";

interface Props {
  timezone?: string;
}

const { timezone = locationConfig.timezone } = Astro.props;

const iconSrc = icon.src;
---

<live-clock class="clock-widget" data-timezone={timezone}>
  <span
    class="clock-widget__image"
    style={{ "--clock-icon": `url("${iconSrc}")` }}
    aria-hidden="true"
  />
  <div class="clock-widget__text">
    <div class="clock-widget__headline">
      <time class="clock-widget__time" aria-live="off">
        --:--:--
      </time>
      <span class="clock-widget__zone" data-clock-zone title={timezone}></span>
    </div>
    <p class="clock-widget__details" data-clock-date></p>
    <noscript>Enable JavaScript to see the current time.</noscript>
  </div>
</live-clock>

<script>
  class LiveClock extends HTMLElement {
    private interval?: number;

    connectedCallback() {
      const time = this.querySelector("time");
      const date = this.querySelector("[data-clock-date]");
      const zone = this.querySelector("[data-clock-zone]");
      if (!time || !date || !zone) return;

      const timeZone = this.dataset.timezone;
      let timeFormatter: Intl.DateTimeFormat;
      let dateFormatter: Intl.DateTimeFormat;
      let zoneFormatter: Intl.DateTimeFormat;

      try {
        timeFormatter = new Intl.DateTimeFormat("en-US", {
          timeZone,
          hour: "numeric",
          minute: "2-digit",
          second: "2-digit",
          hour12: true,
        });
        dateFormatter = new Intl.DateTimeFormat("en-US", {
          timeZone,
          weekday: "short",
          month: "short",
          day: "numeric",
          year: "numeric",
        });
        zoneFormatter = new Intl.DateTimeFormat("en-US", {
          timeZone,
          timeZoneName: "short",
        });
      } catch {
        time.textContent = "Time unavailable";
        return;
      }

      const update = () => {
        const now = new Date();
        time.textContent = timeFormatter.format(now);
        time.dateTime = now.toISOString();
        date.textContent = dateFormatter.format(now);
        const abbreviation = zoneFormatter
          .formatToParts(now)
          .find((part) => part.type === "timeZoneName")?.value;
        zone.textContent = abbreviation ?? timeZone ?? "";
      };

      update();
      this.interval = window.setInterval(update, 1000);
    }

    disconnectedCallback() {
      window.clearInterval(this.interval);
    }
  }

  if (!customElements.get("live-clock")) {
    customElements.define("live-clock", LiveClock);
  }
</script>

<style>
  .clock-widget {
    display: flex;
    align-items: center;
    gap: var(--space-4);

    color: inherit;
    text-decoration: none;
  }

  .clock-widget__image {
    flex-shrink: 0;
    width: 48px;
    height: 48px;
    background-color: var(--color-text);
    mask: var(--clock-icon) center / contain no-repeat;
    image-rendering: pixelated;
  }

  .clock-widget__text {
    min-width: 0;
    min-height: 48px;
  }

  .clock-widget__text p {
    margin: 0;
  }

  .clock-widget__time {
    color: #fff;
    font-size: 1.5rem;
    line-height: 28px;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .clock-widget__headline {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-2);
  }

  .clock-widget__zone {
    font-size: 1rem;
    line-height: 20px;
    color: var(--color-text-muted);
  }

  .clock-widget__details {
    font-size: 1rem;
    line-height: 20px;
    color: var(--color-text-muted);
    overflow-wrap: anywhere;
  }
</style>

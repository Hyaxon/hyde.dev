---
import Card from "./Card.astro";

import type { ProjectEntry } from "../../lib/projects";
import { projectIcons } from "../../lib/projects/icons";

interface Props {
  project: ProjectEntry;
}

const { project } = Astro.props;

const iconSrc = projectIcons[project.data.category];
const href = `/projects/${project.id}`;
---

<Card href={href}>
  <div class="project-card">
    <span
      class="project-card__image"
      style={{ "--project-icon": `url("${iconSrc}")` }}
      aria-hidden="true"
    />

    <div class="project-card__body">
      <h3 class="project-card__title">{project.data.title}</h3>

      <p class="project-card__description">{project.data.description}</p>
    </div>

    <div class="project-card__action" aria-hidden="true">
      <span>Learn More</span>
      <span>›</span>
    </div>
  </div>
</Card>

<style>
  .project-card {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: var(--space-4);
    column-gap: var(--space-2);
  }

  .project-card__image {
    align-self: start;
    margin-right: var(--space-2);
    width: 48px;
    height: 48px;
    background-color: var(--color-text);
    mask: var(--project-icon) center / contain no-repeat;
    image-rendering: pixelated;
  }

  .project-card__body {
    min-width: 0;
  }

  .project-card__title {
    margin: 0;
    font: inherit;
    font-size: var(--font-size-base);
    font-weight: normal;
    color: var(--color-text);
  }

  .project-card__description {
    margin: 0.1875rem 0 0;
    font-size: 0.875em;
    color: var(--color-text-muted);
    line-height: 1.25;
  }

  .project-card__action {
    display: inline-flex;
    font-size: 0.875em;
    align-items: center;
    gap: var(--space-2);
    white-space: nowrap;
    color: var(--color-text-muted);
  }

  :global(.card:hover) .project-card__action,
  :global(.card:focus-visible) .project-card__action {
    color: var(--color-text);
  }

  @media (max-width: 36rem) {
    .project-card {
      grid-template-columns: auto minmax(0, 1fr);
    }

    .project-card__action {
      grid-column: 2;
      justify-self: start;
      margin-top: var(--space-2);
    }
  }
</style>

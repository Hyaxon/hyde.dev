---
interface Props {
  command?: "cat" | "ls" | "exit";
  value?: string;
}

const pathname = Astro.url.pathname;

const cleanPath = pathname.replace(/^\/+|\/+$/g, "");
const isDirectory = ["projects", "posts", "games"].includes(cleanPath);

const command = Astro.props.command ?? (isDirectory ? "ls" : "cat");
const value =
  Astro.props.value ??
  (isDirectory
    ? `${cleanPath}/`
    : cleanPath === ""
      ? "home.hy"
      : `${cleanPath}.hy`);
---

<div
  class="terminal-path shell"
  aria-label={`Terminal command: ${command} ${value}`}
>
  <span class="terminal-path__command">&gt;</span>
  <span class="terminal-path__command"> {command} </span>
  <span class="terminal-path__value">{value}</span>
</div>

<style>
  .terminal-path {
    font-family: var(--font-mono);
    font-size: var(--font-size-sm);
    line-height: 1.4;

    margin-bottom: var(--space-2);
  }

  .terminal-path__command {
    color: var(--color-text-muted);
  }

  .terminal-path__value {
    color: var(--color-text);
  }
</style>

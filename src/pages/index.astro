---
import BaseLayout from "../layouts/BaseLayout.astro";

import ItemBox from "../components/ui/ItemBox.astro";
import ItemList from "../components/ui/ItemList.astro";
import PostCard from "../components/ui/PostCard.astro";
import { getPosts } from "../lib/posts/selectors";
import ProjectCard from "../components/ui/ProjectCard.astro";
import TerminalPath from "../components/ui/TerminalPath.astro";

import { getHomepageProjects } from "../lib/projects/selectors";
import HeroAscii from "../components/ui/HeroAscii.astro";

const homepagePosts = (await getPosts()).slice(0, 5);

const homepageProjects = await getHomepageProjects(6);
---

<BaseLayout>
  <main class="shell home">
    <section class="hero">
      <ItemBox>
        <HeroAscii />
      </ItemBox>
    </section>

    <section class="about">
      <ItemBox title="About">
        <div class="about__columns">
          <div class="about__text">
            <p>
              Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed
              porttitor vulputate dolor, sed blandit enim tincidunt ac. Interdum
              et malesuada fames ac ante ipsum primis in faucibus. Proin vel
              urna at tortor molestie efficitur non vel purus!
            </p>
            <p>
              Vivamus nulla ante, fermentum sit amet sem in, ornare condimentum
              eros. Mauris quis mollis mi, eget facilisis lectus. Phasellus nisl
              velit, commodo a sapien non, condimentum luctus sapien. Aliquam
              lorem nulla, ultrices sed interdum quis, accumsan at dolor. Nulla
              massa augue, porta id tortor sit amet, ultrices blandit odio. In
              dapibus rutrum mauris sed mollis.
            </p>
          </div>
          <div class="about__text">
            <p>
              Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed
              porttitor vulputate dolor, sed blandit enim tincidunt ac. Interdum
              et malesuada fames ac ante ipsum primis in faucibus. Proin vel
              urna at tortor molestie efficitur non vel purus.
            </p>
            <p>
              Vivamus nulla ante, fermentum sit amet sem in, ornare condimentum
              eros. Mauris quis mollis mi, eget facilisis lectus. Phasellus nisl
              velit, commodo a sapien non, condimentum luctus sapien. Aliquam
              lorem nulla, ultrices sed interdum quis, accumsan at dolor. Nulla
              massa augue, porta id tortor sit amet, ultrices blandit odio. In
              dapibus rutrum mauris sed mollis.
            </p>
          </div>
        </div>
      </ItemBox>
    </section>

    <div class="dashboard">
      <div class="dashboard-column">
        <section class="projects">
          <ItemList title="Projects" viewAllHref="/projects">
            {homepageProjects.map((project) => (
              <ProjectCard project={project} />
            ))}
          </ItemList>
        </section>

        <section class="stats">
          <ItemBox>
            <p>Site Stats</p>
            <p>Uptime</p>
          </ItemBox>
        </section>

        <section class="resume">
          <ItemBox>
            <p>Get my resume:</p>
          </ItemBox>
        </section>

        <section class="game">
          <ItemBox>
            <p>Play a game</p>
          </ItemBox>
        </section>

        <section class="ad1">
          <ItemBox>
            <p>ad</p>
          </ItemBox>
        </section>

        <section class="email">
          <ItemBox>
            <p>email me:</p>
          </ItemBox>
        </section>

        <section class="links">
          <ItemBox>
            <p>My Links!</p>
          </ItemBox>
        </section>
      </div>

      <div class="dashboard-column">
        <section class="posts">
          <ItemList title="Posts" viewAllHref="/posts">
            {homepagePosts.length ? (
              homepagePosts.map((post) => (
                <PostCard
                  title={post.data.title}
                  href={`/posts/${post.id}`}
                  date={post.data.publishedAt}
                />
              ))
            ) : (
              <p>No posts yet.</p>
            )}
          </ItemList>
        </section>

        <section class="contributions">
          <ItemBox>
            <p>GH Stats</p>
          </ItemBox>
        </section>

        <section class="project-activity">
          <ItemBox>
            <p>Project Activity</p>
          </ItemBox>
        </section>

        <section class="weather">
          <ItemBox>
            <p>Weather</p>
          </ItemBox>
        </section>

        <section class="time">
          <ItemBox>
            <p>Time</p>
          </ItemBox>
        </section>

        <section class="ad2">
          <ItemBox>
            <p>ad</p>
          </ItemBox>
        </section>

        <section class="watch-activity">
          <ItemBox>
            <p>Last watched:</p>
          </ItemBox>
        </section>

        <section class="fun">
          <ItemBox>
            <p>Fun!</p>
            <p>Event Logs!</p>
          </ItemBox>
        </section>

        <section class="site-settings">
          <ItemBox>
            <p>Site Settings</p>
          </ItemBox>
        </section>
      </div>
    </div>
  </main>
</BaseLayout>

<style>
  .hero :global(.item-box__content) {
    padding-block: 14px;
  }

  .home {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .about__columns {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    align-items: start;
    gap: var(--space-6);
  }

  .about__text {
    min-width: 0;
    line-height: 1.5;
  }

  .about__text p {
    margin: 0;
  }

  .about__text p + p {
    margin-top: var(--space-4);
  }

  .dashboard {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-6);
    align-items: start;
  }

  .dashboard-column {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
    min-width: 0;
  }

  @media (max-width: 48rem) {
    .about__columns {
      grid-template-columns: 1fr;
    }

    .hero :global(.item-box__content) {
      padding-block: 12px;
    }

    .dashboard {
      grid-template-columns: 1fr;
    }

    .dashboard-column {
      display: contents;
    }

    .projects {
      order: 1;
    }

    .posts {
      order: 2;
    }

    .contributions {
      order: 3;
    }

    .project-activity {
      order: 4;
    }

    .stats {
      order: 5;
    }

    .weather {
      order: 6;
    }

    .watch-activity {
      order: 7;
    }

    .resume {
      order: 8;
    }

    .email {
      order: 9;
    }

    .game {
      order: 10;
    }

    .fun {
      order: 11;
    }

    .site-settings {
      order: 12;
    }

    .links {
      order: 13;
    }
  }
</style>

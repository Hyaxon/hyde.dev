---
import { render } from "astro:content";
import { getPosts } from "../../lib/posts/selectors";
import ContentLayout from "../../layouts/ContentLayout.astro";
import ItemBox from "../../components/ui/ItemBox.astro";

export async function getStaticPaths() {
  const posts = await getPosts();

  return posts.map((post) => ({
    params: {
      id: post.id,
    },
    props: {
      post,
    },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const publishedAt = post.data.publishedAt;
const updatedAt = post.data.updatedAt;
const blurb = post.data.blurb;

const formatDate = (date: Date) =>
  date.toLocaleDateString("en-US", {
    year: "numeric",
    month: "short",
    day: "numeric",
  });
---

<ContentLayout title={post.data.title} description={post.data.description}>
  <div class="post">
    <header class="post-header">
      <h1>{post.data.title}</h1>
    </header>

    <div class="post-grid">
      <div class="dates">
        <span>Published {formatDate(publishedAt)}</span>

        {updatedAt && (
          <span class="updated">Updated {formatDate(updatedAt)}</span>
        )}
      </div>

      {blurb && <p class="blurb">{blurb}</p>}

      <div class="post-content">
        <ItemBox>
          <Content />
        </ItemBox>
      </div>
    </div>
  </div>
</ContentLayout>

<style>
  .post {
    width: min(var(--content-width), calc(100% - var(--space-8)));
    margin-inline: auto;
  }

  .post-header {
    margin-bottom: var(--space-6);
  }

  .post-header h1 {
    margin-top: var(--space-2);
    margin-bottom: var(--space-6);
  }

  .post-grid {
    display: grid;
    grid-template-columns: 14rem minmax(0, 60ch);

    column-gap: var(--space-6);
    row-gap: var(--space-8);

    padding-top: var(--space-4);

    border-top: var(--border-width) solid var(--color-border);
  }

  .dates {
    grid-column: 1;
    grid-row: 1;

    display: flex;
    flex-direction: column;
    gap: var(--space-1);

    margin: 0;

    color: var(--color-text);
    line-height: 1.4;
  }

  .updated {
    color: var(--color-text-muted);
  }

  .blurb {
    grid-column: 2;
    grid-row: 1;

    align-self: baseline;

    margin: 0;

    color: var(--color-text);
    font-size: 1.5rem;
    line-height: 1.4;
  }

  .post-content {
    grid-column: 2;
    grid-row: 2;

    min-width: 0;
  }

  @media (max-width: 700px) {
    .post-grid {
      grid-template-columns: 1fr;
      row-gap: var(--space-6);
    }

    .dates,
    .blurb,
    .post-content {
      grid-column: 1;
      grid-row: auto;
    }
  }
</style>
